# Settings for the CNC File Manager. Loaded automatically at startup.
# After editing this file, restart the service:  restart-service.bat

# -- Multicam controller ----------------------------------------------------
# Auto-connect on startup so uploads and the folder watcher work without
# anyone clicking Connect. If the machine is off at boot, the app keeps
# retrying every FM_RECONNECT_INTERVAL seconds until it answers.
FM_CONTROLLER_IP=192.168.0.100
FM_CONTROLLER_NAME=CNC Cut
FM_RECONNECT_INTERVAL=30

# -- Auto-send: MULTICAM ----------------------------------------------------
# Drop a .nc into this Google Drive folder from any computer, anywhere, and it
# is sent to the Multicam controller within ~20 seconds. Only .nc files are
# picked up; a file is only sent once its size stops changing, so a half-synced
# file is never pushed.
FM_WATCH_DIR=G:\.shortcut-targets-by-id\1zMTCdWG88zuUEqwYxxtSvwDVZi9hLBUq\File Dump\MULTICAM
# Optional: a subfolder on the controller to drop them into (default: jobs root).
# FM_WATCH_SUBDIR=
FM_WATCH_INTERVAL=10

# -- Auto-send: WOODTRON ----------------------------------------------------
# Same deal, but files go over FTP to the Woodtron. Replaces the old
# "WatchFolder WOODTRON.ps1" script, which had to be started by hand and only
# noticed files created locally.
FM_WOODTRON_DIR=G:\.shortcut-targets-by-id\1zMTCdWG88zuUEqwYxxtSvwDVZi9hLBUq\File Dump\WOODTRON
FM_WOODTRON_HOST=192.168.0.200
FM_WOODTRON_REMOTE_DIR=/
FM_WOODTRON_USER=anonymous
FM_WOODTRON_PASSWORD=anonymous@
FM_WOODTRON_INTERVAL=10

# -- What happens after a file is sent ---------------------------------------
# A file that reaches the machine is MOVED into this subfolder of its watch
# folder, so the main folder only ever holds work that still has to go. The
# move happens only after a confirmed delivery, and the file is never removed
# from the main folder until it exists in here.
# Set this empty to leave delivered files where they are.
FM_ARCHIVE_SUBFOLDER=Sent

# -- Where state and logs are kept ------------------------------------------
# Deliberately off OneDrive and off Google Drive: these files are written every
# few seconds, and a sync client fighting them causes lost or corrupted state.
FM_STATE_DIR=C:\CNCFileManager\state
FM_LOG_DIR=C:\CNCFileManager\logs

# -- Rarely needed ----------------------------------------------------------
# Override the jobs root path on the controller if file listing comes back
# empty or wrong after connecting. See file_manager/controller.py for details.
# FM_JOBS_ROOT=\hard disk2\release\jobs
