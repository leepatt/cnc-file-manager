# Copy to .env and edit. Every setting is optional — with none of them set the
# web UI still runs, it just won't auto-connect or auto-send anything.
# After editing .env, run restart-service.bat.

# ── Multicam controller ─────────────────────────────────────────────────────
# Auto-connect on startup, skipping the manual Connect step. If the machine is
# off at boot, the app retries until it answers.
# FM_CONTROLLER_IP=192.168.0.100
# FM_CONTROLLER_NAME=CNC Cut
# FM_RECONNECT_INTERVAL=30      # seconds between reconnect attempts

# ── Auto-send: Multicam ─────────────────────────────────────────────────────
# Watch a local folder (typically a Google Drive for Desktop folder) and upload
# any .nc dropped into it to the controller. See WATCH-FOLDER.md.
# FM_WATCH_DIR=G:\My Drive\Multicam Inbox
# FM_WATCH_SUBDIR=              # optional controller subfolder (default: jobs root)
# FM_WATCH_INTERVAL=10          # seconds between checks

# ── Auto-send: Woodtron ─────────────────────────────────────────────────────
# Same, but delivered over FTP to the Woodtron.
# FM_WOODTRON_DIR=G:\My Drive\Woodtron Inbox
# FM_WOODTRON_HOST=192.168.0.200
# FM_WOODTRON_PORT=21
# FM_WOODTRON_REMOTE_DIR=/
# FM_WOODTRON_USER=anonymous
# FM_WOODTRON_PASSWORD=anonymous@
# FM_WOODTRON_INTERVAL=10

# ── After a file is sent ────────────────────────────────────────────────────
# Delivered files are MOVED into this subfolder of the watch folder, so the
# main folder only holds work still to go. Empty = leave them in place.
# FM_ARCHIVE_SUBFOLDER=Sent

# ── State and logs ──────────────────────────────────────────────────────────
# Keep these off OneDrive and off Google Drive — they are written every few
# seconds and a sync client fighting them causes lost or corrupted state.
# FM_STATE_DIR=C:\CNCFileManager\state
# FM_LOG_DIR=C:\CNCFileManager\logs

# ── Rarely needed ───────────────────────────────────────────────────────────
# Override the jobs root on the controller if the file listing comes back empty
# or wrong after connecting. See file_manager/controller.py.
# FM_JOBS_ROOT=\hard disk2\release\jobs

# Sweep macOS "._" sidecar files off a mounted Multicam share.
# FM_GHOST_CLEANUP_DIR=
# FM_GHOST_CLEANUP_INTERVAL=30
